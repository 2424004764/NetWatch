[DriverCopy]
NetWatchStrict.sys

[ServiceInstall]
DisplayName=%ServiceName%
Description=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\NetWatchStrict.sys

[Strings]
