<Window x:Class="NetWatch.App.UploadLimitAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置上传限速 — NetWatch"
        Height="330" Width="620" MinHeight="300" MinWidth="560"
        ResizeMode="NoResize"
        Background="#FF202024" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="程序路径（完整 exe）" Foreground="#FFB9B9C4" FontSize="12" Margin="0,0,0,5"/>
        <DockPanel Grid.Row="1">
            <Button DockPanel.Dock="Right" Content="浏览…" Click="OnBrowse" Margin="8,0,0,0" Padding="14,6"/>
            <TextBox x:Name="AppBox" Height="30" FontSize="12" VerticalContentAlignment="Center"
                     Background="#FF28282E" Foreground="#FFF2F2F6" BorderBrush="#FF3A3A44"
                     BorderThickness="1" Padding="6,0"/>
        </DockPanel>

        <TextBlock Grid.Row="2" Text="上传上限（出站速度）" Foreground="#FFB9B9C4" FontSize="12" Margin="0,14,0,5"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Top">
            <TextBox x:Name="RateBox" Width="180" Height="30" FontSize="13"
                     VerticalContentAlignment="Center" Padding="6,0"
                     Background="#FF28282E" Foreground="#FFF2F2F6" BorderBrush="#FF3A3A44"/>
            <ComboBox x:Name="UnitBox" Width="100" Height="30" Margin="8,0,0,0">
                <ComboBoxItem Content="KB/s" IsSelected="True"/>
                <ComboBoxItem Content="MB/s"/>
            </ComboBox>
            <TextBlock Margin="14,7,0,0" Foreground="#FF8A8A96" FontSize="11"
                       Text="单程序 best-effort 限速；多个 exe 的严格共享上限请使用“严格总限速组”。"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="确定" Click="OnOk" Padding="22,7" Margin="0,0,10,0"/>
            <Button Content="取消" Click="OnCancel" Padding="22,7"/>
        </StackPanel>
    </Grid>
</Window>
