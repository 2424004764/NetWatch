<Window x:Class="NetWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetWatch · 应用网络流量监控"
        Height="640" Width="950" MinHeight="440" MinWidth="760"
        Background="#FF202024" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border Background="#FF2A2A31" BorderBrush="#FF3A3A44"
                                BorderThickness="0,0,1,1" Padding="10,8">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="#FFB9B9C4" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 重写行模板：悬浮/选中都用深色高亮，避免默认主题的白色 hover 让浅色文字看不清 -->
        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Foreground" Value="#FFD8D8DE"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <GridViewRowPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2F2F38"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A4162"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF6A6A74"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FF9A9AA4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="12,6" Margin="1,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2F2F38"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3F55"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF33333C"/>
            <Setter Property="Foreground" Value="#FFE8E8EC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF45454F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2B2B33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部：整机速率汇总 + 视图切换 + 屏蔽管理入口 -->
        <Border DockPanel.Dock="Top" Background="#FF28282E" Padding="16,12,16,10">
            <DockPanel>
                <Button x:Name="BtnBlockList" DockPanel.Dock="Right" Content="🚫 屏蔽管理"
                        Click="OnOpenBlockList" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="🧲 HTTP 调试"
                        Click="OnOpenHttpDebug" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right" Background="#FF26262D" CornerRadius="4"
                        Padding="2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbViewApp" Style="{StaticResource Seg}" Content="应用"
                                     IsChecked="True" Checked="OnViewApp"/>
                        <RadioButton x:Name="RbViewIp" Style="{StaticResource Seg}" Content="目标 IP"
                                     Checked="OnViewIp"/>
                    </StackPanel>
                </Border>
                <Grid DockPanel.Dock="Right" Width="215" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Height="32" Padding="9,0" FontSize="12.5"
                             Background="#FF26262D" BorderBrush="#FF3A3A44" BorderThickness="1"
                             Foreground="#FFF2F2F6" CaretBrush="White" VerticalContentAlignment="Center"
                             TextChanged="OnSearchChanged" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock Text="🔍 搜索应用或 IP…" IsHitTestVisible="False" Foreground="#FF6A6A74"
                               FontSize="12" VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="总上传 " Foreground="#FF9A9AA4" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalUpSpeed" Text="0 B/s" Foreground="#FFF0B25A"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,22,0" VerticalAlignment="Center"/>
                        <TextBlock Text="总下载 " Foreground="#FF9A9AA4" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalDownSpeed" Text="0 B/s" Foreground="#FF7CC98B"
                                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0" FontSize="11.5" Foreground="#FF8A8A96">
                        <Run Text="累计上传 "/><Run x:Name="GrandUp" Foreground="#FFC9C9D2"/>
                        <Run Text=" / 累计下载 "/><Run x:Name="GrandDown" Foreground="#FFC9C9D2"/>
                        <Run Text="（自 NetWatch 启动起统计）"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#FF1A1A1F" Padding="16,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="#FF7A7A86" FontSize="11"
                           VerticalAlignment="Center"
                           Text="双击应用查看连接详情 · 关闭窗口最小化到托盘"/>
                <TextBlock x:Name="StatusText" Foreground="#FF7A7A86" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- 主区域：应用视图 / 目标 IP 视图 -->
        <Grid>
        <ListView x:Name="AppList" Background="Transparent" BorderThickness="0"
                  Padding="6,4,10,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="AppList_MouseDoubleClick">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="查看连接详情" Click="OnViewConnections"/>
                    <MenuItem Header="打开文件位置" Click="OnOpenLocation"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="应用程序" Width="340">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" MinHeight="28" ToolTip="{Binding ToolTipText}">
                                    <Image Source="{Binding Icon}" Width="22" Height="22"
                                           Margin="2,0,9,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="#FFF2F2F6" FontSize="12.5"/>
                                        <TextBlock Text="{Binding SubTitle}" FontSize="10.5"
                                                   Foreground="#FF8A8A96" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="310"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="↑ 上传速度" Width="108">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding UpSpeedText}" Foreground="#FFF0B25A"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="↓ 下载速度" Width="108">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding DownSpeedText}" Foreground="#FF7CC98B"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="累计上传" Width="96">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding TotalUpText}" Foreground="#FFC9C9D2"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="累计下载" Width="96">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding TotalDownText}" Foreground="#FFC9C9D2"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="连接" Width="58">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding ConnText}" Foreground="#FF9A9AA4"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 目标 IP 视图：数据发给了谁 -->
        <ListView x:Name="IpList" Background="Transparent" BorderThickness="0"
                  Padding="6,4,10,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Visibility="Collapsed" MouseDoubleClick="IpList_MouseDoubleClick">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="查看该 IP 的数据包" Click="OnCapturePackets"/>
                    <MenuItem Header="打开关联应用文件位置" Click="OnOpenIpLocation"/>
                    <MenuItem Header="屏蔽此 IP（所有程序）" Click="OnBlockIpGlobal"/>
                    <MenuItem Header="取消屏蔽此 IP" Click="OnUnblockIpRow"/>
                    <Separator/>
                    <MenuItem Header="复制 IP" Click="OnCopyIp"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="远程 IP" Width="215">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IpText}" Foreground="#FFF2F2F6"
                                           FontSize="12.5" VerticalAlignment="Center"
                                           ToolTip="{Binding ToolTipText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="↑ 上传速度" Width="108">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding UpSpeedText}" Foreground="#FFF0B25A"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="↓ 下载速度" Width="108">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding DownSpeedText}" Foreground="#FF7CC98B"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="累计上传" Width="92">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding TotalUpText}" Foreground="#FFC9C9D2"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="累计下载" Width="92">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding TotalDownText}" Foreground="#FFC9C9D2"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="通信的应用" Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AppsText}" Foreground="#FF9A9AA4"
                                           FontSize="11.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
    </DockPanel>
</Window>
