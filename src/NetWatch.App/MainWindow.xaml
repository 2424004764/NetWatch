<Window x:Class="NetWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetWatch · 应用网络流量监控"
        Height="640" Width="950" MinHeight="440" MinWidth="760"
        Background="#FF202024" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border Background="#FF2A2A31" BorderBrush="#FF3A3A44"
                                BorderThickness="0,0,1,1" Padding="10,8">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="#FFB9B9C4" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Foreground" Value="#FFD8D8DE"/>
            <Setter Property="Padding" Value="4,6"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF3A4162"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2F2F38"/>
            </Style.Resources>
        </Style>

        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部：整机速率汇总 -->
        <Border DockPanel.Dock="Top" Background="#FF28282E" Padding="16,12,16,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="总上传 " Foreground="#FF9A9AA4" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalUpSpeed" Text="0 B/s" Foreground="#FFF0B25A"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,22,0" VerticalAlignment="Center"/>
                    <TextBlock Text="总下载 " Foreground="#FF9A9AA4" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalDownSpeed" Text="0 B/s" Foreground="#FF7CC98B"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Margin="0,5,0,0" FontSize="11.5" Foreground="#FF8A8A96">
                    <Run Text="累计上传 "/><Run x:Name="GrandUp" Foreground="#FFC9C9D2"/>
                    <Run Text=" / 累计下载 "/><Run x:Name="GrandDown" Foreground="#FFC9C9D2"/>
                    <Run Text="（自 NetWatch 启动起统计）"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#FF1A1A1F" Padding="16,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="#FF7A7A86" FontSize="11"
                           VerticalAlignment="Center"
                           Text="双击应用查看连接详情 · 关闭窗口最小化到托盘"/>
                <TextBlock x:Name="StatusText" Foreground="#FF7A7A86" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- 主列表 -->
        <ListView x:Name="AppList" Background="Transparent" BorderThickness="0"
                  Padding="6,4,10,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="AppList_MouseDoubleClick">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="查看连接详情" Click="OnViewConnections"/>
                    <MenuItem Header="打开文件位置" Click="OnOpenLocation"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="应用程序" Width="340">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" MinHeight="28" ToolTip="{Binding ToolTipText}">
                                    <Image Source="{Binding Icon}" Width="22" Height="22"
                                           Margin="2,0,9,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="#FFF2F2F6" FontSize="12.5"/>
                                        <TextBlock Text="{Binding SubTitle}" FontSize="10.5"
                                                   Foreground="#FF8A8A96" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="310"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="↑ 上传速度" Width="108">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding UpSpeedText}" Foreground="#FFF0B25A"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="↓ 下载速度" Width="108">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding DownSpeedText}" Foreground="#FF7CC98B"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="累计上传" Width="96">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding TotalUpText}" Foreground="#FFC9C9D2"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="累计下载" Width="96">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding TotalDownText}" Foreground="#FFC9C9D2"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="连接" Width="58">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding ConnText}" Foreground="#FF9A9AA4"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
