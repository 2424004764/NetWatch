<Window x:Class="NetWatch.App.StrictUploadGroupAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加严格上传进程组 — NetWatch"
        Height="510" Width="720" MinHeight="460" MinWidth="620"
        ResizeMode="CanResize"
        Background="#FF202024" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="进程组名称" Foreground="#FFB9B9C4" FontSize="12" Margin="0,0,0,5"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Height="30" Padding="6,0" FontSize="12"
                 Background="#FF28282E" Foreground="#FFF2F2F6" BorderBrush="#FF3A3A44"/>
        <DockPanel Grid.Row="2" Margin="0,14,0,5">
            <TextBlock Text="成员 exe（每行一个完整路径）" Foreground="#FFB9B9C4" FontSize="12"/>
            <Button DockPanel.Dock="Right" Content="添加 exe…" Click="OnBrowse" Padding="12,5"/>
        </DockPanel>
        <TextBox x:Name="PathsBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11.5" Padding="7"
                 Background="#FF28282E" Foreground="#FFF2F2F6" BorderBrush="#FF3A3A44"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="共享上传上限" Foreground="#FFB9B9C4" FontSize="12" VerticalAlignment="Center"/>
            <TextBox x:Name="RateBox" Width="150" Height="30" Margin="12,0,0,0" FontSize="13"
                     VerticalContentAlignment="Center" Padding="6,0"
                     Background="#FF28282E" Foreground="#FFF2F2F6" BorderBrush="#FF3A3A44"/>
            <ComboBox x:Name="UnitBox" Width="92" Height="30" Margin="8,0,0,0">
                <ComboBoxItem Content="KB/s" IsSelected="True"/>
                <ComboBoxItem Content="MB/s"/>
            </ComboBox>
        </StackPanel>
        <TextBlock Grid.Row="5" Margin="0,14,0,0" Foreground="#FFB9B9C4" FontSize="11"
                   TextWrapping="Wrap" Text="组内所有成员共享一个总上限。只有 WFP 严格限速驱动已加载时才会真正启用；代理、VPN 或隧道的实际出站进程也必须加入组。"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="确定" Click="OnOk" Padding="22,7" Margin="0,0,10,0"/>
            <Button Content="取消" Click="OnCancel" Padding="22,7"/>
        </StackPanel>
    </Grid>
</Window>
