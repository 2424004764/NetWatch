<Window x:Class="NetWatch.App.BlockAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加屏蔽规则 — NetWatch"
        Height="330" Width="520" ResizeMode="NoResize"
        Background="#FF202024" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="远程地址 / 网段" Foreground="#FFB9B9C4" FontSize="12" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" x:Name="RemoteBox" Height="30" FontSize="13" VerticalContentAlignment="Center"
                 Background="#FF28282E" Foreground="#FFF2F2F6" BorderBrush="#FF3A3A44" BorderThickness="1" Padding="6,0"
                 Text="1.2.3.4" GotFocus="RemoteBox_GotFocus"/>

        <TextBlock Grid.Row="2" Text="程序路径（留空 = 所有程序）" Foreground="#FFB9B9C4" FontSize="12" Margin="0,14,0,5"/>
        <DockPanel Grid.Row="3">
            <Button DockPanel.Dock="Right" Content="浏览…" Click="OnBrowse" Margin="8,0,0,0" Padding="14,6"/>
            <TextBox x:Name="AppBox" Height="30" FontSize="12" VerticalContentAlignment="Center"
                     Background="#FF28282E" Foreground="#FFF2F2F6" BorderBrush="#FF3A3A44" BorderThickness="1" Padding="6,0"/>
        </DockPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="确定" Click="OnOk" Padding="22,7" Margin="0,0,10,0"/>
            <Button Content="取消" Click="OnCancel" Padding="22,7"/>
        </StackPanel>
    </Grid>
</Window>
