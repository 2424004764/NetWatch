<Window x:Class="NetWatch.App.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="680" Width="980" MinHeight="420" MinWidth="680"
        Background="#FF202024" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#FF2A2A31"/>
            <Setter Property="Foreground" Value="#FFB9B9C4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#FF3A3A44"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF28282E" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Foreground="#FFF2F2F6" FontSize="13.5" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#FF8A8A96"
                           Text="标记说明：🔒=加密（明文不可见）· DNS/HTTP 等明文协议直接可读 · 点号=不可读字符 · 仅支持 IPv4"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="#FF232329" Padding="12,7">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="#FF8A8A96"
                           FontSize="11.5" VerticalAlignment="Center" Text="捕获中…"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnPause" Content="⏸ 暂停" Click="OnTogglePause" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DirFilter" Width="88" Margin="0,0,8,0"
                              SelectionChanged="OnDirFilterChanged">
                        <ComboBoxItem Content="全部方向" IsSelected="True"/>
                        <ComboBoxItem Content="仅上行 ↑"/>
                        <ComboBoxItem Content="仅下行 ↓"/>
                    </ComboBox>
                    <ComboBox x:Name="ViewMode" Width="88"
                              SelectionChanged="OnViewModeChanged">
                        <ComboBoxItem Content="文本" IsSelected="True"/>
                        <ComboBoxItem Content="十六进制"/>
                    </ComboBox>
                    <Button Content="清空" Click="OnClear" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="280"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" x:Name="PacketGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                      Background="Transparent" Foreground="#FFD8D8DE" RowBackground="Transparent"
                      AlternatingRowBackground="#FF232329" GridLinesVisibility="None"
                      BorderThickness="0" FontSize="12" ClipboardCopyMode="IncludeHeader"
                      SelectionChanged="OnPacketSelected" FontFamily="Consolas, Microsoft YaHei UI">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="86"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="方向" Binding="{Binding Dir}" Width="46">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOut}" Value="True">
                                        <Setter Property="Foreground" Value="#FFF0B25A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOut}" Value="False">
                                        <Setter Property="Foreground" Value="#FF7CC98B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="远程端口" Binding="{Binding Remote}" Width="110"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="协议" Binding="{Binding Proto}" Width="52"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="长度" Binding="{Binding Len}" Width="64"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="内容预览" Binding="{Binding Preview}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="5" Background="#FF28282E"
                          HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
            <TextBox Grid.Row="2" x:Name="DetailBox" IsReadOnly="True"
                     Background="#FF1A1A1F" Foreground="#FFC9C9D2" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" Padding="10,8"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     Text="（选择上方数据包查看内容）" TextChanged="DetailBox_TextChanged"/>
        </Grid>
    </DockPanel>
</Window>
