<Window x:Class="NetWatch.App.HttpDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="680" Width="1020" MinHeight="420" MinWidth="700"
        Background="#FF202024" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#FF2A2A31"/>
            <Setter Property="Foreground" Value="#FFB9B9C4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#FF3A3A44"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF28282E" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Foreground="#FFF2F2F6" FontSize="13.5" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#FF8A8A96"
                           Text="HTTPS 也能看到明文：先安装调试根证书，再开启系统代理，然后重启你的软件。仅用于调试自己的软件，用完请移除证书并关闭代理。"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="#FF232329" Padding="12,7">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="#FF8A8A96"
                           FontSize="11.5" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnCert" Content="① 安装调试根证书" Click="OnToggleCert" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSysProxy" Content="② 开启系统代理" Click="OnToggleProxy" Margin="0,0,8,0"/>
                    <TextBox x:Name="FilterBox" Width="230" Margin="0,0,8,0"
                             VerticalContentAlignment="Center" Padding="6,3"
                             Background="#FF1A1A1F" Foreground="#FFD8D8DE"
                             BorderBrush="#FF3A3A44" CaretBrush="#FFD8D8DE"
                             ToolTip="筛选：多个关键字空格分隔（全部满足）&#10;!开头 = 排除&#10;例：idaqimg&#10;例：POST !OPTIONS&#10;例：200 json"
                             TextChanged="OnFilterChanged"/>
                    <ComboBox x:Name="ViewMode" Width="88" Margin="0,0,8,0"
                              SelectionChanged="OnViewModeChanged">
                        <ComboBoxItem Content="文本" IsSelected="True"/>
                        <ComboBoxItem Content="十六进制"/>
                    </ComboBox>
                    <Button Content="清空" Click="OnClear"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="300"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" x:Name="ReqGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                      Background="Transparent" Foreground="#FFD8D8DE" RowBackground="Transparent"
                      AlternatingRowBackground="#FF232329" GridLinesVisibility="None"
                      BorderThickness="0" FontSize="12" ClipboardCopyMode="IncludeHeader"
                      SelectionChanged="OnReqSelected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="86"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="58"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="52">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Foreground" Value="#FF7CC98B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="#FFE07A7A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="↑ 请求" Binding="{Binding ReqText}" Width="78"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="↓ 响应" Binding="{Binding RespText}" Width="78"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding ContentType}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="5" Background="#FF28282E"
                          HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
            <TextBox Grid.Row="2" x:Name="DetailBox" IsReadOnly="True"
                     Background="#FF1A1A1F" Foreground="#FFC9C9D2" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" Padding="10,8"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     Text="（选择上方请求查看完整内容）"/>
        </Grid>
    </DockPanel>
</Window>
