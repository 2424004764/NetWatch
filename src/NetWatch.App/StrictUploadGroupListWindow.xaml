<Window x:Class="NetWatch.App.StrictUploadGroupListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="严格上传进程组 — NetWatch"
        Height="520" Width="1080" MinHeight="380" MinWidth="760"
        Background="#FF202024" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#FF2A2A31"/>
            <Setter Property="Foreground" Value="#FFB9B9C4"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#FF3A3A44"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF28282E" Padding="14,10">
            <StackPanel>
                <TextBlock Foreground="#FFF2F2F6" FontSize="13.5" FontWeight="SemiBold"
                           Text="严格上传进程组"/>
                <TextBlock x:Name="StatusText" Margin="0,4,0,0" FontSize="11" Foreground="#FFB9B9C4"
                           Text="多个 exe 共享同一个总上传上限。" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#FF1A1A1F" Padding="12,9">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="添加进程组" Click="OnAdd" Margin="0,0,8,0"/>
                <Button Content="修改" Click="OnEdit" Margin="0,0,8,0"/>
                <Button Content="启用 / 停用" Click="OnToggle" Margin="0,0,8,0"/>
                <Button Content="删除" Click="OnRemove" Margin="0,0,8,0"/>
                <Button Content="刷新" Click="OnRefresh" Margin="0,0,8,0"/>
                <Button Content="关闭" Click="OnClose"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="GroupGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                  Background="Transparent" Foreground="#FFD8D8DE" RowBackground="Transparent"
                  AlternatingRowBackground="#FF232329" GridLinesVisibility="None"
                  BorderThickness="0" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="进程组" Binding="{Binding Name}" Width="160"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="成员 exe" Binding="{Binding Members}" Width="*"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="共享上限" Binding="{Binding Rate}" Width="120"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="已计费" Binding="{Binding Accounted}" Width="110"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="队列" Binding="{Binding Queued}" Width="100"
                                    ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
