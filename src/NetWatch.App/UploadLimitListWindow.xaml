<Window x:Class="NetWatch.App.UploadLimitListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="上传限速管理 — NetWatch"
        Height="480" Width="900" MinHeight="340" MinWidth="680"
        Background="#FF202024" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#FF2A2A31"/>
            <Setter Property="Foreground" Value="#FFB9B9C4"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#FF3A3A44"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF28282E" Padding="14,10">
            <StackPanel>
                <TextBlock Foreground="#FFF2F2F6" FontSize="13.5" FontWeight="SemiBold" Text="上传限速规则"/>
                <TextBlock x:Name="HintText" Margin="0,4,0,0" FontSize="11" Foreground="#FF8A8A96"
                           Text="单程序 best-effort 限速：仅按一个 exe 路径匹配，不是多个进程共享的严格总上限。"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#FF1A1A1F" Padding="12,9">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="添加限速" Click="OnAdd" Margin="0,0,8,0"/>
                <Button Content="修改" Click="OnEdit" Margin="0,0,8,0"/>
                <Button Content="启用 / 停用" Click="OnToggle" Margin="0,0,8,0"/>
                <Button Content="取消限速" Click="OnRemove" Margin="0,0,8,0"/>
                <Button Content="关闭" Click="OnClose"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="LimitGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                  Background="Transparent" Foreground="#FFD8D8DE" RowBackground="Transparent"
                  AlternatingRowBackground="#FF232329" GridLinesVisibility="None"
                  BorderThickness="0" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="程序" Binding="{Binding AppPath}" Width="*"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="上传上限" Binding="{Binding Rate}" Width="125"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="创建时间" Binding="{Binding Created}" Width="160"
                                    ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
